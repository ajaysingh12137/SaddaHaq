    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "jest": "^29.6.3",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}
