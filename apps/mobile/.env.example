# Copy to apps/mobile/.env. Values are baked into the JS bundle at build time —
# never put secrets here. Restart Metro with --reset-cache after changing.

# Android emulator reaches the host machine at 10.0.2.2.
# For a physical phone, use your computer's LAN IP (same Wi-Fi), e.g. http://192.168.1.20:4000
API_URL=http://10.0.2.2:4000

# Optional crash reporting (Phase 6). Leave empty to disable.
SENTRY_DSN=
