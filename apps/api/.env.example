# Copy to apps/api/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave empty in development to use an in-memory MongoDB (data lost on restart).
# Required in production, e.g. mongodb+srv://user:pass@cluster.example.mongodb.net/saddahaq
MONGO_URI=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production. Rotating PHONE_HASH_SECRET makes every existing account unreachable.
JWT_ACCESS_SECRET=
PHONE_HASH_SECRET=

# console = prints OTPs to the server log (dev only). msg91 = real SMS.
OTP_PROVIDER=console
# MSG91 (PLACEHOLDER — fill from your MSG91 dashboard; India requires a DLT-approved template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp

# Comma-separated browser origins allowed by CORS (the mobile app needs none).
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the API (1 behind a single load balancer).
TRUST_PROXY=0

# Optional error reporting. Leave empty to disable.
SENTRY_DSN=
