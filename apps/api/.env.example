# Copy to apps/api/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave empty in development to use an in-memory MongoDB (data lost on restart).
# Required in production, e.g. mongodb+srv://user:pass@cluster.example.mongodb.net/saddahaq
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
MONGO_URI=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production. Rotating PHONE_HASH_SECRET makes every existing account unreachable.
JWT_ACCESS_SECRET=
PHONE_HASH_SECRET=

# console = prints OTPs to the server log (dev only). msg91 or textlocal = real SMS.
# fixed = test login: every number signs in with FIXED_OTP_CODE and no SMS is sent.
#   Refused in production unless ALLOW_TEST_LOGIN=true. Never use with real workers.
OTP_PROVIDER=console
FIXED_OTP_CODE=123456
# ALLOW_TEST_LOGIN=true
# MSG91 (PLACEHOLDER — fill from your MSG91 dashboard; India requires a DLT-approved template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp
# Textlocal India. TEXTLOCAL_MESSAGE must be your DLT-approved template text, character
# for character, with {otp} where the code goes; any other text is rejected by DLT.
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=
TEXTLOCAL_TEMPLATE_ID=
TEXTLOCAL_MESSAGE=

# Comma-separated browser origins allowed by CORS (the mobile app needs none).
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the API (1 behind a single load balancer).
TRUST_PROXY=0

# Optional error reporting. Leave empty to disable.
SENTRY_DSN=
